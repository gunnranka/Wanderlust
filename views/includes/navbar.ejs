    .search-input-block:hover { background-color: #f7f7f7; }
    .search-input-block input:focus { box-shadow: none !important; outline: none !important; background-color: transparent !important; }

    .btn-counter { width: 32px !important; height: 32px !important; border: 1px solid #b0b0b0 !important; background-color: #ffffff !important; color: #717171 !important; font-size: 18px !important; font-weight: 300 !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; border-radius: 50% !important; transition: all 0.2s ease !important; padding: 0 !important; box-shadow: none !important; }
    .btn-counter:hover { border-color: #222222 !important; color: #222222 !important; background-color: #ffffff !important; }
    #adult-count, #child-count { font-size: 16px !important; font-weight: 400 !important; color: #222222 !important; min-width: 24px; text-align: center; display: inline-block; }
    .dropdown-item { color: #222222 !important; font-size: 14px; }
    .dropdown-item i { color: #666666 !important; }
    @media (max-width: 991px) { .search-container { width: 100% !important; margin-bottom: 1rem; } }
</style>