<script>
    document.addEventListener("DOMContentLoaded", function() {
        const toggleBtn = document.getElementById("manualProfileToggleBtn");
        const listMenu = document.getElementById("customProfileListMenu");

        if (toggleBtn && listMenu) {
            toggleBtn.addEventListener("click", function(event) {
                event.stopPropagation();
                listMenu.classList.toggle("d-none");
                listMenu.classList.toggle("show");
            });

            document.addEventListener("click", function(event) {
                if (!document.getElementById("customProfileDropdownMenuContainer").contains(event.target)) {
                    listMenu.classList.add("d-none");
                    listMenu.classList.remove("show");
                }
            });
        }
    });
</script>

