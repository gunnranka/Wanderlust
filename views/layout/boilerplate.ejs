<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/light.css">

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/rating.css">

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
</head>

<body class="d-flex flex-column min-vh-100">
    
    <%- include("../includes/navbar.ejs") %>

    <div class="container flex-grow-1 mt-3">
        <%- include("../includes/flash.ejs") %>
        <%- body %>
    </div>

    <%- include("../includes/footer.ejs") %>

   <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    
    <script>
        // 1. Bootstrap Form Validation Logic (Immediately Invoked)
        (() => {
          'use strict'
          const forms = document.querySelectorAll('.needs-validation')
          Array.from(forms).forEach(form => {
            form.addEventListener('submit', event => {
              if (!form.checkValidity()) {
                event.preventDefault()
                event.stopPropagation()
              }
              form.classList.add('was-validated')
            }, false)
          })
        })();

        // 2. GUESTS COUNTER SYSTEM (Globally Exposed for HTML Onclick Hooks)
        let adults = 0;
        let children = 0;
        
        window.updateCount = function(type, change) {
            if (type === 'adults') {
                adults = Math.max(0, adults + change);
                const adultCountEl = document.getElementById("adult-count");
                if (adultCountEl) adultCountEl.innerText = adults;
            } else if (type === 'children') {
                children = Math.max(0, children + change);
                const childCountEl = document.getElementById("child-count");
                if (childCountEl) childCountEl.innerText = children;
            }
            
            let total = adults + children;
            const placeholder = document.getElementById("guests-placeholder");
            
            if (placeholder) {
                if (total === 0) {
                    placeholder.innerText = "Add guests";
                    placeholder.classList.add("text-muted");
                } else {
                    placeholder.innerText = `${total} guest${total > 1 ? 's' : ''}`;
                    placeholder.classList.remove("text-muted");
                }
            }
        };

        // 3. Airbnb Style Search Dropdown & Calendar Logic (Runs as soon as DOM is ready)
        document.addEventListener("DOMContentLoaded", function () {
            
            // A. DUAL MONTH CALENDAR SYSTEM (Flatpickr)
            const whenInput = document.getElementById("when-input");
            if (whenInput) {
                flatpickr("#when-input", {
                    mode: "range",
                    minDate: "today",
                    showMonths: 2,
                    dateFormat: "Y-m-d"
                });
            }

            // B. DATABASE AUTOCOMPLETE LOCATION ENGINE
            const inputField = document.getElementById("where-input");
            const listPanel = document.getElementById("db-location-dropdown");

            if (inputField && listPanel) {
                // Focus Event to open list
                inputField.addEventListener("focus", async () => {
                    try {
                        const response = await fetch("/listings/api/locations");
                        const dataset = await response.json();
                        
                        listPanel.innerHTML = ""; // Clear old nodes
                        
                        if(dataset.length > 0) {
                            listPanel.classList.remove("d-none");
                            listPanel.classList.add("show"); // Bootstrap visibility trigger toggle
                            
                            dataset.forEach(item => {
                                const link = document.createElement("a");
                                link.className = "dropdown-item py-2 d-flex align-items-center rounded-3 text-dark";
                                link.style.cursor = "pointer";
                                link.innerHTML = `<i class="fa-solid fa-location-dot me-3 text-secondary"></i> <span class="fw-medium">${item}</span>`;
                                
                                link.addEventListener("click", (e) => {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    inputField.value = item;
                                    listPanel.classList.remove("show");
                                    listPanel.classList.add("d-none");
                                });
                                listPanel.appendChild(link);
                            });
                        }
                    } catch(e) {
                        console.error("Autocomplete engine failure:", e);
                    }
                });

                // Auto hide dropdown on clicking outside bounds
                document.addEventListener("click", (e) => {
                    if (!inputField.contains(e.target) && !listPanel.contains(e.target)) {
                        listPanel.classList.remove("show");
                        listPanel.classList.add("d-none");
                    }
                });
            }
        });
    </script>
</body>
</html>