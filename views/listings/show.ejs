<% layout('layout/boilerplate') %>

<style>
    /* ================= ⭐ STAR RATING (Interactive) ================= */
    .starability-basic {
        display: flex !important;
        flex-direction: row-reverse !important;
        justify-content: center !important;
        border: none !important;
        gap: 5px;
    }

    .starability-basic input { 
        position: absolute;
        opacity: 0;
        cursor: pointer;
    }

    .starability-basic label {
        font-size: 2.5rem;
        color: #ddd;
        cursor: pointer;
        transition: 0.2s;
    }

    .starability-basic label::before {
        content: "★";
    }

    .starability-basic label:hover,
    .starability-basic label:hover ~ label,
    .starability-basic input:checked ~ label {
        color: #fe424d !important;
    }

    /* ================= IMAGE & LAYOUT ================= */
    .show-img { 
        height: 400px !important; 
        object-fit: cover; 
        border-radius: 1.5rem !important; 
    }

    #map { 
        height: 400px; 
        width: 100%; 
        max-width: 900px;
        margin: 0 auto; 
        border-radius: 1rem; 
        border: 1px solid #ddd; 
    }
</style>

<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3><%= listing.title %></h3>
    </div>

    <div class="card col-8 offset-2 show-card listing-card border-0">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body px-0">
            <p class="card-text">
                Owned by <i><%= listing.owner ? listing.owner.username : "Anonymous" %></i>
            </p>
            <p class="card-text"><%= listing.description %></p>
            <p class="card-text"><b>&#8377; <%= listing.price.toLocaleString("en-IN") %></b></p>
            <p class="card-text"><%= listing.location %>, <%= listing.country %></p>
        </div>
    </div>

    <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
    <div class="col-8 offset-2 d-flex gap-3 mb-4 mt-3">
        <a href="/listings/<%= listing._id %>/edit" class="btn px-4" style="background-color:#fe424d; color:white;">Edit</a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark px-4">Delete</button>
        </form>
    </div>
    <% } %>

    <div class="col-8 offset-2 mb-3">
        <hr />
        <% if(currUser) { %>
        <h4>Leave a Review</h4>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
            <div class="mb-3 mt-3 text-center">
                <label class="form-label">Rating</label>
                <fieldset class="starability-basic">
                    <input type="radio" id="rate5" name="review[rating]" value="5" />
                    <label for="rate5" title="Amazing"></label>
                    <input type="radio" id="rate4" name="review[rating]" value="4" />
                    <label for="rate4" title="Very Good"></label>
                    <input type="radio" id="rate3" name="review[rating]" value="3" />
                    <label for="rate3" title="Average"></label>
                    <input type="radio" id="rate2" name="review[rating]" value="2" />
                    <label for="rate2" title="Not Good"></label>
                    <input type="radio" id="rate1" name="review[rating]" value="1" checked />
                    <label for="rate1" title="Terrible"></label>
                </fieldset>
            </div>

            <div class="mb-3">
                <label class="form-label">Comments</label>
                <textarea name="review[comment]" class="form-control" rows="5" required></textarea>
                <div class="invalid-feedback">Please add a comment for the review.</div>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <hr />
        <% } %>

        <% if(listing.reviews.length > 0) { %>
        <div class="row">
            <p><b>All Reviews</b></p>
            <% for(review of listing.reviews) { %>
            <div class="card col-5 ms-3 mb-3 p-3 shadow-sm border-0">
                <div class="card-body">
                    <h5>@<%= review.author ? review.author.username : "User" %></h5>
                    <p style="color:#fe424d; font-size:1.2rem;">
                        <%= "★".repeat(review.rating) %><%= "☆".repeat(5 - review.rating) %>
                    </p>
                    <p class="text-muted small"><%= review.comment %></p>
                    <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                        <button class="btn btn-sm btn-dark">Delete</button>
                    </form>
                    <% } %>
                </div>
            </div>
            <% } %>
        </div>
        <hr />
        <% } %>
    </div>

    <div class="col-8 offset-2 mb-4 text-center">
        <h3 class="mb-3">Where you'll be</h3>
        <div id="map" 
            data-lng="<%= (listing.geometry && listing.geometry.coordinates) ? listing.geometry.coordinates[0] : 77.2090 %>" 
            data-lat="<%= (listing.geometry && listing.geometry.coordinates) ? listing.geometry.coordinates[1] : 28.6139 %>"
            data-title="<%= listing.title %>">
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const mapContainer = document.getElementById('map');
        const lng = parseFloat(mapContainer.getAttribute('data-lng'));
        const lat = parseFloat(mapContainer.getAttribute('data-lat'));
        const title = mapContainer.getAttribute('data-title');

        // Leaflet Initialization (Uses Latitude, Longitude order)
        if (!isNaN(lat) && !isNaN(lng)) {
            var map = L.map('map').setView([lat, lng], 10); 
            
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap'
            }).addTo(map);

            L.marker([lat, lng]).addTo(map)
                .bindPopup(`<b>${title}</b><br>Exact location provided after booking.`)
                .openPopup();
        } else {
            mapContainer.innerHTML = "<p class='text-muted'>Map data unavailable for this location.</p>";
        }
    });
</script>