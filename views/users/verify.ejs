<% layout('layout/boilerplate') %>

<div class="row mt-3">
    <div class="col-6 offset-3">
        <h2 class="mb-2">Confirm your email</h2>
        <p class="text-muted small">Enter the 6-digit code we sent to <strong><%= email %></strong></p>
        
        <form action="/verify-otp" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
                <input 
                    name="otp" 
                    type="text" 
                    maxLength="6"
                    class="form-control text-center py-2 fs-4" 
                    placeholder="0 0 0 0 0 0"
                    style="letter-spacing: 8px; font-weight: bold;"
                    required
                />
                <div class="invalid-feedback">Please enter the 6-digit verification code.</div>
            </div>

            <button class="btn w-100 py-2 text-white" style="background-color: #fe424d; font-weight: 600; border-radius: 8px;">
                Verify & Log In
            </button>
        </form>
        
        <div class="text-center mt-3">
            <a href="/login" class="text-decoration-none small text-dark fw-bold">Change email</a>
        </div>
    </div>
</div>